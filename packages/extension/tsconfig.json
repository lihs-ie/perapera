{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "types": ["chrome"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "noEmit": true
  },
  "include": [".wxt/wxt.d.ts", "src/**/*", "tests/**/*"],
  "exclude": ["node_modules", ".output", "dist", "coverage", "e2e"]
}
