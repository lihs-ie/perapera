# perapera 環境変数テンプレート
# 本ファイルはリポジトリにコミットしてよい。`.env` / `.env.local` は必ず gitignore 側。
# 拡張（Chrome 拡張）側は API キーを一切保持しないため、ここに並ぶのは Relay API 側の変数のみ。

# --- Node / runtime ---
NODE_ENV=development
LOG_LEVEL=debug

# --- HTTP server ---
PORT=3001
HOST=0.0.0.0

# --- CORS ---
# 複数 origin はカンマ区切り。dev では拡張 ID を chrome://extensions で確認して追記する。
ALLOWED_ORIGINS=http://localhost:3000

# --- Auth ---
# MVP: dev では長期アクセストークンを許容。stream-token は POST /sessions で短命発行。
ACCESS_TOKEN_SECRET=change-me-dev
STREAM_TOKEN_SECRET=change-me-dev
STREAM_TOKEN_TTL_SECONDS=1800

# --- Rate limit ---
RATE_LIMIT_SESSIONS_PER_MIN=30
RATE_LIMIT_AUDIO_FRAMES_PER_SECOND=10
RATE_LIMIT_MAX_CONCURRENT_SESSIONS=3

# --- External providers ---
# MVP 初期はモックで動かす想定。実プロバイダを入れるときに上書きする。
STT_PROVIDER=mock
STT_API_KEY=
TRANSLATION_PROVIDER=mock
TRANSLATION_API_KEY=
